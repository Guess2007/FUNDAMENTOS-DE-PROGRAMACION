# Copia este archivo a ".env" y ajusta los valores según tu instalación de MySQL
# (el usuario/contraseña que configuraste al instalar MySQL Server / MySQL Workbench)

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=genshin_calc
DB_PORT=3306
DB_SSL=false

# Cambia esto por una cadena larga y aleatoria antes de usar en producción
JWT_SECRET=cambia_esta_clave_por_una_segura

PORT=3000

# ── Para producción (ej. Render + TiDB Cloud) ──────────────────
# NO pongas estos valores aquí ni los subas a GitHub: se configuran
# como variables de entorno directamente en el panel de Render.
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_USER=xxxxxxx.root
# DB_PASSWORD=********
# DB_NAME=genshin_calc
# DB_PORT=4000
# DB_SSL=true
